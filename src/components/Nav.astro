---
---
<nav>
  <a href="/" class="logo">J <em>Wanders</em> Off Again</a>
  <div class="nav-right">
    <a href="/#posts" class="nav-link">Wanders</a>
    <a href="/#about" class="nav-link">About</a>
    <a href="/#newsletter" class="nav-cta">Stay in the Loop</a>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0; z-index: 100;
    height: 64px;
    padding: 0 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(248, 246, 241, 0.96);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--ivory-line);
  }

  .logo {
    font-family: var(--font-logo);
    font-size: 1.22rem;
    font-weight: 400;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0;
    word-spacing: -0.05em;
  }

  .logo em { font-style: italic; color: var(--denim); }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover { color: var(--denim); }

  .nav-cta {
    background: var(--denim);
    color: var(--white);
    text-decoration: none;
    padding: 0.48rem 1.2rem;
    border-radius: 50px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 0.22s;
    box-shadow: 0 3px 14px rgba(90,126,158,0.22);
  }

  .nav-cta:hover {
    background: var(--denim-h);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(90,126,158,0.28);
  }

  @media (max-width: 600px) {
    nav { padding: 0 5%; }
    .nav-link { display: none; }
  }
</style>
