---
import BaseLayout from './BaseLayout.astro';
import PostNav from '../components/PostNav.astro';

interface Props {
  title: string;
  description: string;
  ogUrl: string;
  ogImage: string;
  articlePublishedTime: string;
  articleTags: string[];
  pinterestDescription: string;
  heroImage: string;
  heroImagePosition?: string;
  tag: string;
  headline: string;
  headlineEmphasis: string;
  date: string;
  readTime: string;
  closingLine: string;
}

const {
  title, description, ogUrl, ogImage,
  articlePublishedTime, articleTags, pinterestDescription,
  heroImage, heroImagePosition = 'center center',
  tag, headline, headlineEmphasis, date, readTime, closingLine,
} = Astro.props;
---
<BaseLayout
  {title} {description}
  ogType="article"
  {ogUrl} {ogImage}
  {articlePublishedTime} {articleTags}
  {pinterestDescription}
>
  <PostNav/>

  <div class="hero" style={`background-image:url('${heroImage}'); background-position: ${heroImagePosition};`}>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-tag" set:html={tag}/>
      <h1 class="hero-title">
        {headline}<br/>
        <em>{headlineEmphasis}</em>
      </h1>
      <div class="hero-meta">
        <span>{date}</span>
        <span>·</span>
        <span>{readTime}</span>
      </div>
    </div>
  </div>

  <div class="post-wrap">
    <div class="post-body">
      <slot/>
    </div>
  </div>

  <div class="post-footer">
    <p>{closingLine}</p>
    <a href="/" class="btn-back">← Back to the blog</a>
  </div>
</BaseLayout>

<style is:global>
  /* ── POST HERO ── */
  .hero {
    height: 70vh;
    min-height: 420px;
    background: center center / cover no-repeat;
    position: relative;
    display: flex;
    align-items: flex-end;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26,32,40,0.82) 0%, rgba(26,32,40,0.1) 60%, transparent 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 3rem 6%;
    width: 100%;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--blush);
    color: var(--white);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.3rem 0.8rem;
    border-radius: 50px;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 300;
    line-height: 1.05;
    color: var(--white);
    letter-spacing: -0.02em;
  }

  .hero-title em { font-style: italic; color: var(--blush); }

  .hero-meta {
    margin-top: 1rem;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
    color: rgba(255,255,255,0.65);
    letter-spacing: 0.06em;
  }

  .hero-content > * {
    animation: fadeUp 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-content > *:nth-child(1) { animation-delay: 0.05s; }
  .hero-content > *:nth-child(2) { animation-delay: 0.18s; }
  .hero-content > *:nth-child(3) { animation-delay: 0.32s; }

  /* ── POST BODY ── */
  .post-wrap {
    max-width: 100%;
    margin: 0 auto;
    padding: 4rem 8%;
  }

  .post-body p {
    font-size: 0.97rem;
    color: var(--ink-mid);
    line-height: 1.92;
    margin-bottom: 1.4rem;
  }

  .post-body p strong { color: var(--ink); font-weight: 500; }

  /* ── SECTION HEADERS ── */
  .post-section { margin: 3.5rem 0 1.5rem; }

  .post-section-label {
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--denim);
    margin-bottom: 0.5rem;
  }

  .post-section h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 300;
    line-height: 1.15;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .post-section h2 em { font-style: italic; color: var(--denim); }

  /* ── IMAGES ── */
  .post-img {
    width: 100%;
    max-width: 600px;
    height: auto;
    aspect-ratio: 16/9;
    border-radius: 14px;
    margin: 2.5rem auto;
    display: block;
    box-shadow: 0 8px 32px rgba(26,32,40,0.12);
    background: center center / cover no-repeat;
  }

  .post-img-grid {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 2.5rem auto;
  }

  .post-img-grid .post-img {
    width: 50%;
    max-width: 50%;
    flex-shrink: 0;
    aspect-ratio: 4/3;
    margin: 0;
  }

  .post-img-caption {
    font-size: 0.75rem;
    color: var(--ink-soft);
    text-align: center;
    margin-top: -1.5rem;
    margin-bottom: 2rem;
    font-style: italic;
  }

  /* ── TIP / CALLOUT BOX ── */
  .post-tip {
    margin: 2rem 0;
    padding: 1.2rem 1.5rem;
    background: var(--denim-pale);
    border-left: 3px solid var(--denim);
    border-radius: 0 10px 10px 0;
  }

  .post-tip-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--denim);
    margin-bottom: 0.4rem;
  }

  .post-tip p {
    font-size: 0.92rem !important;
    color: var(--ink) !important;
    margin-bottom: 0 !important;
  }

  .post-tip-blush {
    background: var(--blush-pale);
    border-left-color: var(--blush);
  }

  .post-tip-blush .post-tip-label { color: var(--blush); }

  .post-tip-blush p { margin-bottom: 0.9rem !important; }
  .post-tip-blush p:last-child { margin-bottom: 0 !important; }

  /* ── COST TABLE ── */
  .cost-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.88rem;
  }

  .cost-table th {
    text-align: left;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--ivory-line);
  }

  .cost-table td {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--ivory-line);
    color: var(--ink-mid);
  }

  .cost-table td:last-child,
  .cost-table th:last-child { text-align: right; }

  .cost-table td:nth-child(2),
  .cost-table th:nth-child(2) { text-align: right; color: var(--denim); font-weight: 500; }

  .cost-table td:last-child { color: var(--ink-soft); font-weight: 400; text-align: right; }
  .cost-table th:last-child { color: var(--ink-soft); }
  .cost-table tr:last-child td { border-bottom: none; font-weight: 500; color: var(--ink); }

  /* ── POST DIVIDER ── */
  .post-divider {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 3rem 0;
  }

  .post-divider-line { flex: 1; height: 1px; background: var(--ivory-line); }
  .post-divider-mark { color: var(--blush); font-size: 0.9rem; opacity: 0.7; }

  /* ── POST FOOTER ── */
  .post-footer {
    padding: 4rem 6%;
    background: var(--white);
    text-align: center;
    border-top: 1px solid var(--ivory-line);
  }

  .post-footer p {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-bottom: 1.5rem;
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--denim);
    color: var(--white);
    text-decoration: none;
    padding: 0.82rem 2rem;
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    transition: all 0.22s;
    box-shadow: 0 5px 20px rgba(90,126,158,0.22);
  }

  .btn-back:hover {
    background: var(--denim-h);
    transform: translateY(-2px);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 640px) {
    .post-wrap { padding: 3rem 5%; }
    .post-img { aspect-ratio: 16/9; }
    .post-img-grid { flex-direction: column; }
    .post-img-grid .post-img { width: 100%; max-width: 100%; aspect-ratio: 4/3; }
    .hero { height: 55vh; }
  }
</style>
