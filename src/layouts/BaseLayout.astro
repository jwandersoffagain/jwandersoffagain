---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogUrl?: string;
  ogImage?: string;
  articlePublishedTime?: string;
  articleTags?: string[];
  pinterestDescription?: string;
}

const {
  title,
  description,
  ogType = 'website',
  ogUrl = 'https://jwandersoffagain.pages.dev/',
  ogImage = 'https://jwandersoffagain.pages.dev/og-image.jpg',
  articlePublishedTime,
  articleTags = [],
  pinterestDescription,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-F3TDPYD2LD"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-F3TDPYD2LD');
  </script>

  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>

  <!-- Open Graph / Pinterest -->
  <meta property="og:type" content={ogType}/>
  <meta property="og:site_name" content="J Wanders Off Again"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={ogUrl}/>
  <meta property="og:image" content={ogImage}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:locale" content="en_US"/>
  {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime}/>}
  {articleTags.map(tag => <meta property="article:tag" content={tag}/>)}

  <!-- Pinterest-specific -->
  <meta name="pinterest-rich-pin" content="true"/>
  {pinterestDescription && <meta name="pinterest:description" content={pinterestDescription}/>}

  <link href="https://fonts.googleapis.com/css2?family=Gilda+Display&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet"/>
</head>
<body>
  <slot/>
</body>
</html>
